{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "phase3-advanced-billing-ar": true
    }
  },
  "ignoreCommand": "git log -1 --pretty=%B | grep -q '\\[skip-vercel\\]'",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter ./scripts exec tsx --test ../artifacts/therassistant-inventory/tests/**/*.test.ts && pnpm --filter @workspace/therassistant-inventory run typecheck:phase3 && pnpm --filter @workspace/therassistant-inventory run build",
  "outputDirectory": "artifacts/therassistant-inventory/dist/public",
  "rewrites": [
    {
      "source": "/payment-desk",
      "destination": "/payment-desk.html"
    },
    {
      "source": "/payment-desk/",
      "destination": "/payment-desk.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
